# Places API (New) kulcs — Google Cloud Console → davelopment projekt →
# APIs & Services → Credentials. IP-címre (szerver) és "Places API (New)"-ra
# korlátozva.
GOOGLE_PLACES_API_KEY=

# A davelopment Google Cégem-profil Place ID-ja (ChIJ...-vel kezdődik).
GOOGLE_PLACE_ID=

# Opcionális — csak akkor kell, ha a script nem a repo megszokott
# helyéről fut, és a frontend/public mappa máshol van.
# GOOGLE_RATING_PUBLIC_DIR=/var/www/davelopment/frontend/public
